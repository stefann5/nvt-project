# Warehouse Configuration
WAREHOUSE_ID=1
WAREHOUSE_NAME=Glavni magacin Beograd

# Sectors (comma-separated)
# Available default configs: Cold Storage, Ambient, Freezer, Refrigerated, Climate Controlled
WAREHOUSE_SECTORS=Sektor A - Gume,Sektor B - Ulja i hemija,Sektor C - Delovi

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Intervals (in seconds)
HEARTBEAT_INTERVAL=15
TEMPERATURE_INTERVAL=60
